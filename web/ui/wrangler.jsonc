{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gertrude-ui-catalog",
  "compatibility_date": "2026-05-11",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
  },
  "compatibility_flags": ["nodejs_compat"],
}
