{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "marketing",
  "compatibility_date": "2025-12-22",
  "build": {
    "command": "cd .. && pnpm install --frozen-lockfile && cd site && pnpm build",
    "cwd": "."
  },
  "assets": {
    "directory": "./out",
    "html_handling": "drop-trailing-slash"
  }
}
