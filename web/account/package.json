{
  "name": "account",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "default",
          "^default",
          {
            "env": "VITE_API_ENDPOINT"
          }
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  },
  "scripts": {
    "start": "vite",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@gertrude/ui": "workspace:*",
    "@shared/datetime": "workspace:*",
    "@shared/pairql": "workspace:*",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/react-query": "5.90.12",
    "@tanstack/react-router": "1.170.16",
    "clsx": "2.1.1",
    "lucide-react": "0.545.0",
    "parse-domain": "7.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.19",
    "@tanstack/router-plugin": "1.168.18",
    "@types/dash-ambient": "workspace:*",
    "@types/node": "22.19.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.0.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.0.11"
  }
}
