{
  "extends": "../tsconfig.json",
  "include": [".storybook/**/*.ts", ".storybook/**/*.tsx"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"]
  }
}
