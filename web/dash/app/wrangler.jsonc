{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "parents",
  "compatibility_date": "2025-12-22",
  "build": {
    // --ignore-scripts prevents long postinstall scripts like cypress, puppeteer
    "command": "cd ../.. && pnpm install --frozen-lockfile --ignore-scripts && cd dash/app && pnpm build",
    "cwd": ".",
  },
  "assets": {
    "directory": "./build",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application",
  },
  // without this cloudflare complains when building for parents-preview
  "env": {
    "preview": {},
  },
}
