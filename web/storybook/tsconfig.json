{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["dash-ambient"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@/public/*": ["../site/public/*"],
      "@/*": ["../site/*"],
      "@site/*": ["../site/*"]
    }
  },
  "include": ["../images.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
