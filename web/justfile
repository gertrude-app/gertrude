set dotenv-filename := "../.gtask-ports"
set dotenv-required := false

_default:
  @just --choose

# local dev

dash:
  @PORT=${DASH_PORT:-8081} pnpm --filter @dash/app start

site:
  @PORT=${SITE_PORT:-3000} pnpm --filter site start

admin:
  @PORT=${ADMIN_PORT:-4243} pnpm --filter admin start

account:
  @pnpm --filter account exec vite dev --port ${ACCOUNT_PORT:-9347}

# live-reload the browser while writing markdoc articles (.md files aren't in the
# module graph, so nudge a module every article route imports)
hmr-articles:
  #!/usr/bin/env bash
  set -euo pipefail
  trap 'just _hmr-unstamp' EXIT
  watchexec --watch site/markdoc/articles --exts md "just _hmr-stamp"

[private]
_hmr-stamp:
  @just _hmr-unstamp
  @echo "// hmr $(date +%s)" >> site/markdoc/files.ts

[private]
_hmr-unstamp:
  @perl -0pi -e 's{\n*// hmr \d+\n?\z}{\n}' site/markdoc/files.ts

storybook:
  @PORT=${STORYBOOK_PORT:-6006} pnpm --filter @storybook/app start

storybook-v2:
  @PORT=${STORYBOOK_V2_PORT:-6007} pnpm --filter storybook-v2 start

dev:
  pnpm concurrently \
  -n ds,st,sb \
  -c cyan.dim,magenta.dim,green.dim \
  "just dash" "just site" "just storybook"

# utility

clean:
  @rm -rf site/.next
  @rm -rf site/out
  @rm -rf dash/app/build
  @rm -rf account/dist
  @rm -rf storybook-v2/storybook-static
  @find . -name "node_modules" -type d -prune -exec rm -rf {} + && pnpm i

nuke-node-modules:
  @pnpm store prune
  @find . -name "node_modules" -type d -prune -exec rm -rf {} + && pnpm i

# build & deploy

build-site:
  @pnpm exec nx run site:build

build-storybook:
  @pnpm exec nx run @storybook/app:build

build-storybook-v2:
  @pnpm exec nx run storybook-v2:build

build-dash:
  @pnpm exec nx run @dash/app:build

build-admin:
  @pnpm exec nx run admin:build

build-account:
  @pnpm exec nx run account:build

# ci/test type things

cy-open:
  @pnpm cypress open --project dash/app

cy-run:
  @pnpm cypress run --project dash/app

smoke-open:
  @pnpm cypress open --project smoke

smoke-run:
  @pnpm cypress run --project smoke

test:
  @pnpm vitest run

test-watch:
  @pnpm vitest watch

visual-test:
  @rm -rf storybook/visual-tests/screenshots/argos
  @cd storybook/visual-tests && ../node_modules/.bin/ts-node --project tsconfig.json run.ts

visual-test-reset:
  @git restore --source=HEAD --staged --worktree -- storybook/visual-tests/screenshots/argos

update-ui-screenshots:
  @pnpm --filter storybook-v2 visual:update

og-export:
  @cd storybook/visual-tests && PUPPETEER_PRODUCT=chrome STORYBOOK_URL=http://localhost:${STORYBOOK_PORT:-6006} ../node_modules/.bin/ts-node --project tsconfig.json export-og-images.ts

format:
  @pnpm prettier --config ../.prettierrc.json --ignore-path ../.prettierignore --log-level warn --write .

format-check:
  @pnpm prettier --config ../.prettierrc.json --ignore-path ../.prettierignore --log-level warn --check .

lint:
  @pnpm eslint . --cache

lint-fix:
  @pnpm eslint . --fix --cache

typecheck:
  @pnpm exec nx run-many --parallel=10 --target=typecheck

# see https://gist.github.com/jaredh159/e75d59ca2fd6abdc5262a87ee43d1344 for alternate method
typecheck-watch:
  @pnpm exec nx run-many --parallel=50 --output-style=stream --target=typecheck:watch

fix: format lint-fix

check: lint format-check typecheck test build-storybook build-storybook-v2 build-site build-dash build-admin build-account

sync-supervise-ui:
  #!/usr/bin/env bash
  set -euo pipefail
  GEN="$HOME/gertie/supervise/src/generated"
  rm -rf "$GEN/supervise"
  cp -r supervise/src "$GEN/supervise"
  rm -rf "$GEN/pairql/supervise"
  mkdir -p "$GEN/pairql/supervise"
  cp -r shared/pairql/src/supervise/. "$GEN/pairql/supervise/"
  cp shared/pairql/src/Client.ts "$GEN/pairql/Client.ts"
  cp shared/pairql/src/Result.ts "$GEN/pairql/Result.ts"
  cp shared/pairql/src/PqlError.ts "$GEN/pairql/PqlError.ts"
  cp shared/pairql/src/types.ts "$GEN/pairql/types.ts"
  rm -rf "$GEN/shared"
  mkdir -p "$GEN/shared/components" "$GEN/shared/datetime" "$GEN/shared/string"
  cp shared/components/src/*.{ts,tsx} "$GEN/shared/components/"
  cp shared/datetime/src/index.ts "$GEN/shared/datetime/index.ts"
  cp shared/string/src/index.ts "$GEN/shared/string/index.ts"
  echo "Synced supervise UI to $HOME/supervise/src/generated"
