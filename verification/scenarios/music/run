#!/usr/bin/env bash
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/lib/common.sh"
source "$verification_root/scenarios/music/config.sh"

command=""
headed=""
browser=""
for arg in "$@"; do
  case "$arg" in
    --headed) headed="--headed" ;;
    --chrome) browser="--browser chrome"; headed="--headed" ;;
    *) [[ -z "$command" ]] && command="$arg" ;;
  esac
done
command="${command:-preflight}"

preflight() {
  echo "music verification preflight"
  echo ""
  echo "api:       $api_url"
  echo "bundle:    $bundle_id"
  echo "reset:     ${reset_url:-unavailable}"
  echo ""

  [[ -d "$root/swift/music" ]] && ok "swift/music exists" || missing "swift/music"
  [[ -f "$ports_file" ]] && ok "ports file loaded (${ports_file#$root/})" || warn "no ports file; using env/defaults ($api_url, $dash_url)"
  check_shared_env
  require_env_value "$root/swift/api/.env" MUSICKIT_KEY_ID "musickit key id (live catalog)"
  require_env_value "$root/swift/api/.env" MUSICKIT_TEAM_ID "musickit team id (live catalog)"
  require_env_value "$root/swift/api/.env" MUSICKIT_PRIVATE_KEY "musickit private key (live catalog)"

  for tool in just xcrun xcodegen maestro pnpm; do
    have "$tool" && ok "$tool available" || missing "$tool"
  done

  if xcrun simctl list devices booted 2>/dev/null | grep -q "Booted"; then
    ok "simulator booted"
    report_sim_os
  else
    warn "no booted simulator"
  fi

  if [[ -d "$app_bundle_path" ]]; then
    ok "simulator app build found: $app_bundle_path"
  else
    warn "simulator app build not found; run: just verify-music app"
  fi

  if http_ready "$api_url/releases"; then
    ok "api reachable"
  else
    warn "api not reachable; start with: just watch-api"
  fi

  echo ""
  echo "next:"
  echo "  just verify-music app"
  echo "  just verify-music flow"
  echo "  just verify-music claim"
  echo "  just verify-music approve"
  echo "  just verify-music e2e"
}

read_dashboard_creds() {
  admin_id="${DASHBOARD_ADMIN_ID:-$claim_parent_creds}"
  admin_token="${DASHBOARD_PARENT_TOKEN:-$claim_parent_creds}"
  ok "dashboard parent: $claim_parent_fixture_name fixture ($admin_id)"
}

run_cypress_dashboard() {
  local spec="$1"
  local project="$root/verification/scenarios/music/dashboard"

  (cd "$root/web" \
    && DASH_PORT="$dash_port" \
       CYPRESS_CLAIM_CODE="${claim_code:-}" \
       CYPRESS_ADMIN_ID="$admin_id" \
       CYPRESS_ADMIN_TOKEN="$admin_token" \
       CYPRESS_CHILD_NAME="$child_name" \
       CYPRESS_SEARCH_TERM="$approve_search_term" \
       CYPRESS_ALBUM_TITLE="$approved_album_title" \
       pnpm cypress run --project "$project" --spec "$project/e2e/$spec" $browser $headed)
}

extract_claim_code() {
  local simulator="$1"
  local deadline=$((SECONDS + 25))

  while (( SECONDS < deadline )); do
    claim_code="$(
      maestro --udid "$simulator" hierarchy --compact \
        | grep -Eo 'https://gertrude\.app/m/[0-9]{6}' \
        | head -1 \
        | sed 's#.*/##' || true
    )"
    if [[ "$claim_code" =~ ^[0-9]{6}$ ]]; then
      ok "music claim code: $claim_code"
      return 0
    fi
    sleep 1
  done

  diagnose_missing_claim_code music
  exit 70
}

claim_music_device() {
  read_dashboard_creds
  child_name="${MUSIC_CHILD_NAME:-$claim_child_name}"

  echo "driving dashboard music claim via cypress (behavior under test)"
  run_cypress_dashboard claim.cy.js
  ok "dashboard music claim completed"
}

approve_album() {
  read_dashboard_creds
  child_name="${MUSIC_CHILD_NAME:-$claim_child_name}"

  echo "driving dashboard album approval via cypress (behavior under test)"
  run_cypress_dashboard approve-album.cy.js
  ok "dashboard album approval completed"
}

app() {
  echo "music app lifecycle"
  echo ""

  for tool in just xcrun xcodegen; do
    if ! have "$tool"; then
      missing "$tool"
      exit 69
    fi
  done

  simulator="$(selected_simulator)"
  simulator_name="$(selected_simulator_name "$simulator")"
  ok "target simulator: ${simulator_name:-unknown} ($simulator)"

  echo ""
  echo "building simulator app"
  (cd "$root/swift/music" && LOCAL_API_ENDPOINT="$api_url" just sim-build)

  if [[ ! -d "$app_bundle_path" ]]; then
    echo "$app_name simulator app not found after build: $app_bundle_path" >&2
    exit 70
  fi
  ok "simulator app build: $app_bundle_path"

  echo ""
  echo "installing simulator app"
  (cd "$root/swift/music" && just sim-install "$simulator")

  app_container="$(xcrun simctl get_app_container "$simulator" "$bundle_id" app)"
  ok "installed app container: $app_container"

  echo ""
  echo "launching simulator app"
  (cd "$root/swift/music" && just sim-launch "$simulator")
  ok "launch command completed"

  echo ""
  echo "next:"
  echo "  just verify-music flow"
}

flow() {
  echo "music maestro flow"
  echo ""

  for tool in maestro xcrun; do
    if ! have "$tool"; then
      missing "$tool"
      exit 69
    fi
  done

  simulator="$(selected_simulator)"
  simulator_name="$(selected_simulator_name "$simulator")"
  ok "target simulator: ${simulator_name:-unknown} ($simulator)"

  maestro test --udid "$simulator" "$verification_root/scenarios/music/flows/claim-code.yaml"
}

claim() {
  echo "music cross-surface claim"
  echo ""

  for tool in maestro pnpm; do
    if ! have "$tool"; then
      missing "$tool"
      exit 69
    fi
  done

  simulator="$(selected_simulator)"
  simulator_name="$(selected_simulator_name "$simulator")"
  ok "target simulator: ${simulator_name:-unknown} ($simulator)"

  extract_claim_code "$simulator"
  claim_music_device
  maestro test --udid "$simulator" "$verification_root/scenarios/music/flows/post-claim-empty-library.yaml"
  ok "app observed dashboard claim"
}

approve() {
  echo "music album approval + playback"
  echo ""

  for tool in maestro pnpm; do
    if ! have "$tool"; then
      missing "$tool"
      exit 69
    fi
  done

  simulator="$(selected_simulator)"
  simulator_name="$(selected_simulator_name "$simulator")"
  ok "target simulator: ${simulator_name:-unknown} ($simulator)"

  approve_album
  maestro test --udid "$simulator" "$verification_root/scenarios/music/flows/play-pause.yaml"
  ok "approved album played and paused in app"
}

reset_api() {
  echo "music api fixture reset"
  echo ""

  reset_server_state
}

reset_sim() {
  echo "music simulator state reset"
  echo ""

  if ! have xcrun; then
    missing xcrun
    exit 69
  fi

  simulator="$(selected_simulator)"
  simulator_name="$(selected_simulator_name "$simulator")"
  ok "target simulator: ${simulator_name:-unknown} ($simulator)"

  xcrun simctl terminate "$simulator" "$bundle_id" >/dev/null 2>&1 || true
  xcrun simctl uninstall "$simulator" "$bundle_id" >/dev/null 2>&1 || true
  ok "app uninstalled"
  xcrun simctl keychain "$simulator" reset
  ok "simulator keychain reset"
}

e2e() {
  reset_api
  echo ""
  reset_sim
  echo ""
  app
  echo ""
  flow
  echo ""
  claim
  echo ""
  approve
}

case "$command" in
  preflight)
    preflight
    ;;
  app)
    app
    ;;
  flow)
    flow
    ;;
  claim)
    claim
    ;;
  approve)
    approve
    ;;
  reset-api)
    reset_api
    ;;
  reset-sim)
    reset_sim
    ;;
  e2e)
    e2e
    ;;
  env)
    echo "API_PORT=$api_port"
    echo "BUNDLE_ID=$bundle_id"
    ;;
  ""|-h|--help|help)
    cat <<EOF
usage: just verify-music [preflight|app|flow|claim|approve|reset-api|reset-sim|e2e|env] [--headed] [--chrome]
EOF
    ;;
  *)
    echo "unknown music verification command: $command" >&2
    exit 64
    ;;
esac
