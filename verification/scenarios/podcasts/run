#!/usr/bin/env bash
set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/lib/common.sh"
source "$verification_root/scenarios/podcasts/config.sh"

command=""
headed=""
browser=""
for arg in "$@"; do
  case "$arg" in
    --headed) headed="--headed" ;;
    --chrome) browser="--browser chrome"; headed="--headed" ;;
    *) [[ -z "$command" ]] && command="$arg" ;;
  esac
done
command="${command:-preflight}"

preflight() {
  echo "podcasts verification preflight"
  echo ""
  echo "api:       $api_url"
  echo "dashboard: $dash_url"
  echo "reset:     ${reset_url:-unavailable}"
  echo ""

  [[ -d "$root/swift/podcasts" ]] && ok "swift/podcasts exists" || missing "swift/podcasts"
  [[ -f "$ports_file" ]] && ok "ports file loaded (${ports_file#$root/})" || warn "no ports file; using env/defaults ($api_url, $dash_url)"
  check_shared_env

  for tool in just xcrun xcodegen; do
    have "$tool" && ok "$tool available" || missing "$tool"
  done

  have pnpm && ok "pnpm available" || warn "pnpm not found"

  have maestro && ok "maestro available" || warn "maestro not found"
  [[ -d "$root/web/node_modules/cypress" ]] && ok "cypress installed (web)" \
    || warn "cypress not installed; run: pnpm --dir web install"

  if xcrun simctl list devices booted 2>/dev/null | grep -q "Booted"; then
    ok "simulator booted"
    report_sim_os
  else
    warn "no booted simulator"
  fi

  if http_ready "$api_url/releases"; then
    ok "api reachable"
  else
    warn "api not reachable; start with: just watch-api"
  fi

  if http_ready "$dash_url"; then
    ok "dashboard reachable"
  else
    warn "dashboard not reachable; start with: just web dash"
  fi

  echo ""
  echo "next:"
  echo "  just podcasts sim-build"
  echo "  just podcasts sim-install"
  echo "  just verify-podcasts flow"
  echo "  just verify-podcasts dashboard"
  echo "  just verify-podcasts e2e"
}

app() {
  echo "podcasts app lifecycle"
  echo ""

  for tool in just xcrun xcodegen; do
    if ! have "$tool"; then
      missing "$tool"
      exit 69
    fi
  done

  simulator="$(selected_simulator)"
  simulator_name="$(selected_simulator_name "$simulator")"
  ok "target simulator: ${simulator_name:-unknown} ($simulator)"

  echo ""
  echo "building simulator app"
  (cd "$root" && LOCAL_API_ENDPOINT="$api_url" just podcasts sim-build)

  echo ""
  echo "installing simulator app"
  (cd "$root" && just podcasts sim-install "$simulator")

  app_container="$(xcrun simctl get_app_container "$simulator" "$bundle_id" app)"
  ok "installed app container: $app_container"

  echo ""
  echo "launching simulator app"
  (cd "$root" && just podcasts sim-launch "$simulator")
  ok "launch command completed"

  echo ""
  echo "next:"
  echo "  just verify-podcasts flow"
}

flow() {
  echo "podcasts maestro flow"
  echo ""

  for tool in maestro xcrun; do
    if ! have "$tool"; then
      missing "$tool"
      exit 69
    fi
  done

  simulator="$(selected_simulator)"
  simulator_name="$(selected_simulator_name "$simulator")"
  ok "target simulator: ${simulator_name:-unknown} ($simulator)"

  maestro test --udid "$simulator" "$root/verification/scenarios/podcasts/flows/onboarding-to-claim-code.yaml"
}

read_dashboard_creds() {
  admin_id="${DASHBOARD_ADMIN_ID:-$claim_parent_creds}"
  admin_token="${DASHBOARD_PARENT_TOKEN:-$claim_parent_creds}"
  ok "dashboard parent: $claim_parent_fixture_name fixture ($admin_id)"
}

run_cypress_dashboard() {
  local spec="$1"
  local claim_code="$2"
  local child_name="$3"
  local project="$root/verification/scenarios/podcasts/dashboard"

  (cd "$root/web" \
    && DASH_PORT="$dash_port" \
       CYPRESS_CLAIM_CODE="$claim_code" \
       CYPRESS_ADMIN_ID="$admin_id" \
       CYPRESS_ADMIN_TOKEN="$admin_token" \
       CYPRESS_CHILD_NAME="$child_name" \
       pnpm cypress run --project "$project" --spec "$project/e2e/$spec" $browser $headed)
}

run_oracle() {
  local claim_code="$1"

  (cd "$root/web/verification" \
    && ORACLE_CLAIM_CODE="$claim_code" \
       ORACLE_ADMIN_TOKEN="$admin_token" \
       API_ENDPOINT="$api_url" \
       DASH_URL="$dash_url" \
       pnpm exec vitest run --config vitest.config.mts podcasts-claim.oracle.ts)
}

extract_claim_code() {
  local simulator="$1"
  local deadline=$((SECONDS + 20))
  local code

  while (( SECONDS < deadline )); do
    code="$(maestro --udid "$simulator" hierarchy --compact 2>/dev/null \
      | grep -Eo 'https://gertrude\.app/p/[0-9]{6}' \
      | head -1 \
      | sed 's#.*/##' || true)"
    if [[ "$code" =~ ^[0-9]{6}$ ]]; then
      echo "$code"
      return 0
    fi
    sleep 2
  done
  return 1
}

now_playing_snapshot() {
  local simulator="$1"
  local data_container db
  data_container="$(xcrun simctl get_app_container "$simulator" "$bundle_id" data)"
  db="$data_container/Documents/db.sqlite"

  [[ -f "$db" ]] || return 1
  sqlite3 -separator $'\t' "$db" "
    SELECT
      np.isPlaying,
      COALESCE(np.bufferedProgress, e.progress, 0),
      e.title,
      s.name
    FROM nowPlaying np
    JOIN episodes e ON e.id = np.episodeId
    JOIN shows s ON s.id = e.showId
    LIMIT 1;
  "
}

assert_audio_playback() {
  local simulator="$1"
  local deadline=$((SECONDS + 20))
  local row is_playing progress title show

  while (( SECONDS < deadline )); do
    row="$(now_playing_snapshot "$simulator" 2>/dev/null || true)"
    if [[ -n "$row" ]]; then
      IFS=$'\t' read -r is_playing progress title show <<<"$row"
      if awk "BEGIN { exit !($progress >= 2.0) }"; then
        ok "audio playback progressed (${progress}s, ${show}: ${title}, isPlaying=$is_playing)"
        return 0
      fi
    fi
    sleep 1
  done

  echo "audio playback did not progress before timeout; last nowPlaying row: ${row:-none}" >&2
  return 70
}

pause_audio() {
  local simulator="$1"

  maestro test --udid "$simulator" "$root/verification/scenarios/podcasts/flows/pause-audio.yaml"
  ok "audio playback paused"
}

claim() {
  echo "podcasts cross-surface claim"
  echo ""

  for tool in maestro pnpm; do
    if ! have "$tool"; then
      missing "$tool"
      exit 69
    fi
  done

  simulator="$(selected_simulator)"
  simulator_name="$(selected_simulator_name "$simulator")"
  ok "target simulator: ${simulator_name:-unknown} ($simulator)"

  claim_code="$(extract_claim_code "$simulator" || true)"
  if [[ -z "$claim_code" ]]; then
    diagnose_missing_claim_code podcasts
    exit 70
  fi
  ok "claim code: $claim_code"

  read_dashboard_creds
  child_name="$claim_child_name"

  echo ""
  echo "driving dashboard claim via cypress (behavior under test)"
  run_cypress_dashboard claim.cy.js "$claim_code" "$child_name"
  ok "dashboard claim completed for $child_name"

  echo ""
  echo "asserting backend recorded the claim via typed pairql oracle"
  run_oracle "$claim_code"
  ok "typed pairql oracle confirms claim persisted"

  maestro test --udid "$simulator" "$root/verification/scenarios/podcasts/flows/claim-success.yaml"
  ok "app observed dashboard claim"
}

pin() {
  echo "podcasts pin setup"
  echo ""

  for tool in maestro xcrun sqlite3; do
    if ! have "$tool"; then
      missing "$tool"
      exit 69
    fi
  done

  simulator="$(selected_simulator)"
  simulator_name="$(selected_simulator_name "$simulator")"
  ok "target simulator: ${simulator_name:-unknown} ($simulator)"

  maestro test --udid "$simulator" "$root/verification/scenarios/podcasts/flows/pin-and-first-show.yaml"
  assert_audio_playback "$simulator"
  pause_audio "$simulator"
  ok "PIN set; show added and playback started"
}

reset_api() {
  echo "podcasts api fixture reset"
  echo ""

  reset_server_state
}

reset_sim() {
  echo "podcasts simulator state reset"
  echo ""

  if ! have xcrun; then
    missing xcrun
    exit 69
  fi

  simulator="$(selected_simulator)"
  simulator_name="$(selected_simulator_name "$simulator")"
  ok "target simulator: ${simulator_name:-unknown} ($simulator)"

  xcrun simctl terminate "$simulator" "$bundle_id" >/dev/null 2>&1 || true
  xcrun simctl uninstall "$simulator" "$bundle_id" >/dev/null 2>&1 || true
  ok "app uninstalled"
  xcrun simctl keychain "$simulator" reset
  ok "simulator keychain reset"
}

e2e() {
  reset_api
  echo ""
  reset_sim
  echo ""
  app
  echo ""
  flow
  echo ""
  claim
  echo ""
  pin
}

case "$command" in
  preflight)
    preflight
    ;;
  app)
    app
    ;;
  flow)
    flow
    ;;
  claim)
    claim
    ;;
  pin)
    pin
    ;;
  reset-api)
    reset_api
    ;;
  reset-sim)
    reset_sim
    ;;
  e2e)
    e2e
    ;;
  env)
    echo "API_PORT=$api_port"
    echo "DASH_PORT=$dash_port"
    echo "RESET_URL=$reset_url"
    ;;
  ""|-h|--help|help)
    cat <<EOF
usage: just verify-podcasts [preflight|app|flow|claim|pin|reset-api|reset-sim|e2e|env] [--headed] [--chrome]

  --headed  run the dashboard cypress specs in a visible browser (default: headless)
  --chrome  drive the dashboard in real Google Chrome instead of Electron (implies --headed)
EOF
    ;;
  *)
    echo "unknown podcasts verification command: $command" >&2
    exit 64
    ;;
esac
