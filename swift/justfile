import 'watch-helpers.just'

mod macapp

set dotenv-filename := "../.gtask-ports"
set dotenv-required := false

api_port := env("API_PORT", "8080")
api_host := env("API_HOST", "0.0.0.0")
ngrok_subdomain := env("NGROK_SUBDOMAIN", "")
swiftly := "${SWIFTLY_HOME_DIR:-$HOME/.swiftly}/bin/swiftly"

_default:
  @just --choose

# ios

watch-ios:
  @just watch-build iosapp/lib-ios

iosapp:
  @open iosapp/Gertrude-iOS.xcodeproj

iosapp-xcode-build:
  @pnpm exec nx run iosapp:xcode-build

iosconfig:
  @printf 'LOCAL_API_ENDPOINT = %s\n' "$(../scripts/local-api-endpoint --xcconfig)" > iosapp/config/Local.xcconfig

ios-tunnel:
  @pkill -f ngrok || true
  @ngrok http {{api_port}} --url https://{{ngrok_subdomain}}.ngrok-free.app

# api

watch-api:
  @just clean-api-port
  @watchexec --project-origin . --clear --restart --watch . --exts swift,html \
  --ignore '**/.build/*/**' \
  --ignore '**/index.html' \
  --ignore 'macapp/**/*' \
  --ignore 'iosapp/**/*' \
  --ignore 'podcasts/**/*' \
  --ignore 'music/**/*' \
  --ignore 'gertie-tca-features/**/*' \
  'just clean-api-port && just run-api'

run-api: build-api
  @just exec-api serve --hostname {{api_host}} --port {{api_port}}

run-api-ip: build-api
  @just exec-api serve --hostname 192.168.10.248

build-api:
  @cd api && {{swiftly}} run swift build

api-build:
  @just build-api

api-test *args:
  @cd api && SWIFT_DETERMINISTIC_HASHING=1 {{swiftly}} run swift test {{args}}

duet-test *args:
  @cd duet && SWIFT_DETERMINISTIC_HASHING=1 {{swiftly}} run swift test {{args}}

macapp-test *args:
  @cd macapp/App && SWIFT_DETERMINISTIC_HASHING=1 {{swiftly}} run swift test {{args}}

macsim-test:
  @just macapp-test --filter MacSimTests

macsim-hunt seeds="80" steps="45":
  @EXPLORE_SEEDS={{seeds}} EXPLORE_STEPS={{steps}} just macapp-test --filter MacExplorerTests

iosapp-test *args:
  @cd iosapp/lib-ios && SWIFT_DETERMINISTIC_HASHING=1 {{swiftly}} run swift test {{args}}

migrate-up: build-api
  @just exec-api migrate --yes

migrate-down: build-api
  @just exec-api migrate --revert --yes

reset: build-api
  just exec-api reset

sync-staging-data: build-api
  @just exec-api sync-staging-data

normalize-music-policy: build-api
  @just exec-api normalize-music-policy

scheduled-marketing-email-dry-run: build-api
  @just exec-api scheduled-marketing-email-dry-run

nuke-test-db:
  @killall -q Postico; db=$(grep '^TEST_DATABASE_NAME=' api/.env | cut -d= -f2); dropdb --if-exists --force "$db"; createdb "$db"

hurl-dev *args:
  @hurl --variable API_URL="http://127.0.0.1:{{api_port}}" {{args}}

hurl-prod *args:
  @hurl --variable API_URL="https://api.gertrude.app" api/hurl/prod.env {{args}}

# emails (requires local dev api running)

send-email template:
  @curl http://127.0.0.1:{{api_port}}/send-test-email/{{template}}

sync-email-templates:
  @curl http://127.0.0.1:{{api_port}}/sync-email-templates

web-email template:
  @curl -s http://127.0.0.1:{{api_port}}/web-test-email/{{template}}

# NB: requires `concurrently`, `vite` in $PATH
watch-web-email template:
  @concurrently -n serve,regen -c cyan.dim,magenta.dim \
    "vite" \
    "bash -c 'while true; do just web-email {{template}}; sleep 2; done;'" \
    "cd dev-emails && npm run dev"

# screenshot a template w/ sample data, no API needed (see docs/templated-emails.md)
preview-email template *args:
  @cd ../web/storybook/visual-tests && node preview-email.mts {{template}} {{args}}

# infra

db-sync:
  @node ../infra/db-sync.mjs

# root

build:
  @just nx-run-many build

test:
  @just nx-run-many test

lint-swift:
  @swiftformat . --lint

format:
  @swiftformat .

lint-xml:
  @xml-lint {{xmlfiles}}

lint-xml-fix:
  @xml-lint --fix {{xmlfiles}}

lint:
  @just lint-swift
  @just lint-xml

fix:
  @just lint-xml-fix
  @just format

check:
  @SWIFT_WARNINGS_AS_ERRORS=1 just build
  @SWIFT_WARNINGS_AS_ERRORS=1 just macapp xcode-build
  @SWIFT_WARNINGS_AS_ERRORS=1 just iosapp-xcode-build
  @SWIFT_WARNINGS_AS_ERRORS=1 just test
  @just lint

nx-reset:
  @pnpm nx reset

clean: nx-reset
  @rm -rf node_modules/.cache
  @rm -rf api/.build duet/.build gertie/.build
  @rm -rf macapp/App/.build iosapp/lib-ios/.build
  @rm -rf pairql/.build pairql-macapp/.build pairql-blocker/.build pairql-ios-apps/.build
  @rm -rf ts-interop/.build x-aws/.build x-http/.build
  @rm -rf x-kit/.build x-postmark/.build x-slack/.build x-stripe/.build

# helpers

[private]
exec-api cmd *args:
  @cd api && ./.build/debug/Run {{cmd}} {{args}}

[private]
clean-api-port:
  @lsof -ti tcp:{{api_port}} | xargs kill -9 2>/dev/null || true

[private]
nx-run-many targets:
  @pnpm exec nx run-many --parallel=10 --targets={{targets}}

# variables

xmlfiles := """
./iosapp/app/app.entitlements \
./iosapp/app/Info.plist \
./iosapp/controller/controller.entitlements \
./iosapp/controller/Info.plist \
./iosapp/filter/filter.entitlements \
./iosapp/filter/Info.plist \
./macapp/Xcode/GertrudeFilterExtension/GertrudeFilterExtension.entitlements \
./macapp/Xcode/GertrudeFilterExtension/Info.plist \
./macapp/Xcode/Gertrude/Gertrude.entitlements \
./macapp/Xcode/Gertrude/Info.plist \
./macapp/Xcode/GertrudeRelauncher/GertrudeRelauncher.entitlements \
./music/app/Info.Debug.additions.plist \
./music/app/Info.Debug.plist \
./music/app/Info.plist \
./podcasts/app/Info.Debug.additions.plist \
./podcasts/app/Info.Debug.plist \
./podcasts/app/Info.plist
"""
