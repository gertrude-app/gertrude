import '../watch-helpers.just'

swiftly := "${SWIFTLY_HOME_DIR:-$HOME/.swiftly}/bin/swiftly"
bundle_id := "com.netrivet.gertrude.am.dev"
sim_derived_data := ".derived-data/sim"

_default:
  @just --choose

gen local_api_endpoint="":
  #!/usr/bin/env bash
  set -euo pipefail
  endpoint='{{local_api_endpoint}}'
  endpoint="${endpoint:-${LOCAL_API_ENDPOINT:-}}"
  endpoint="${endpoint:-$(../../scripts/local-api-endpoint)}"
  LOCAL_API_ENDPOINT="$endpoint" xcodegen -s project.yml
  ../../scripts/derive-debug-plist app/Info.plist app/Info.Debug.additions.plist app/Info.Debug.plist
  xml-lint --fix app/Info.plist app/Info.Debug.plist

xcode:
  @just gen
  @open GertiePodcasts.xcodeproj

previews: gen-previews
  @open previews/GertiePodcastsPreviews.xcodeproj

dev:
  @pnpm concurrently --raw \
    -n lv,lc,lt,sp \
    -c cyan.dim,magenta.dim,green.dim,yellow.dim \
    "just --justfile {{justfile()}} watch-build lib-views" \
    "just --justfile {{justfile()}} watch-build lib-core" \
    "just --justfile {{justfile()}} watch-build lib-tca" \
    "just --justfile {{justfile()}} watch-sync-previews"

build-views:
  @cd lib-views && {{swiftly}} run swift build

build-core:
  @cd lib-core && {{swiftly}} run swift build

build-tca:
  @cd lib-tca && {{swiftly}} run swift build

build:
  @just build-tca
  @just build-core
  @just build-views

test:
  @cd lib-tca && SWIFT_DETERMINISTIC_HASHING=1 {{swiftly}} run swift test
  @cd lib-views && SWIFT_DETERMINISTIC_HASHING=1 {{swiftly}} run swift test

lint:
  @swiftformat --exclude '**/.build' --lint .

check:
  @just build
  @just test
  @just lint

fix:
  @swiftformat --exclude '**/.build' .
  @xml-lint --fix app/Info.plist app/Info.Debug.plist app/LaunchScreen.storyboard
  @prettier --write '**/*.json' '!**/.build/**'

build-app: sim-build

sim-build destination="generic/platform=iOS Simulator":
  @just gen
  @xcodebuild \
    -project GertiePodcasts.xcodeproj \
    -scheme "Gertrude Podcasts" \
    -configuration Debug \
    -destination '{{destination}}' \
    -derivedDataPath {{sim_derived_data}} \
    -skipMacroValidation \
    -skipPackagePluginValidation \
    -quiet \
    build

sim-install simulator="booted":
  #!/usr/bin/env bash
  set -euo pipefail
  app_path="$(find {{sim_derived_data}}/Build/Products/Debug-iphonesimulator -maxdepth 1 -name 'Gertrude Podcasts.app' -print -quit)"
  if [[ -z "$app_path" ]]; then
    echo "Gertrude Podcasts simulator app not found. Run: just sim-build" >&2
    exit 66
  fi
  xcrun simctl install {{simulator}} "$app_path"

sim-launch simulator="booted":
  @xcrun simctl launch {{simulator}} {{bundle_id}}

sim-uninstall simulator="booted":
  @xcrun simctl uninstall {{simulator}} {{bundle_id}} || true

clean:
  @rm -rf lib-tca/.build lib-core/.build lib-views/.build
  @find lib-tca lib-core lib-views -type f \( -name '*.o' -o -name '*.d' -o -name '*.swiftdeps' -o -name '*.swiftdeps~' \) -delete

sim-db:
  @sqlite3 -box {{sim-docs-dir}}/db.sqlite

sim-db-delete:
  @rm -f {{sim-docs-dir}}/db.*

sim-reset:
  @just sim-db-delete
  @rm -rf {{sim-docs-dir}}/shows

sim-fs-open:
  @open {{sim-docs-dir}}

sim-fs-tree:
  @tree {{sim-docs-dir}}

# previews

regen-previews:
  @rm -rf previews
  @just previews

gen-previews:
  @mkdir -p previews/sources
  @just sync-previews
  @xcodegen -s previews.yml --project previews

sync-previews:
  @rsync -rc lib-views/Sources/ previews/sources
  @rsync -rc app/Assets.xcassets/ previews/Assets.xcassets

watch-sync-previews:
  @watchexec --project-origin . --clear --restart \
    --watch lib-views/Sources --watch app/Assets.xcassets --exts swift,html,png,json \
    --ignore '**/.build/*/**' --ignore '**/index.html' \
    'rsync -rc lib-views/Sources/ previews/sources && rsync -rc app/Assets.xcassets/ previews/Assets.xcassets && printf "synced: " && date'


sim-docs-dir := `ls -dt ~/Library/Developer/CoreSimulator/Devices/*/data/Containers/Data/Application/*/Documents | head -1`
