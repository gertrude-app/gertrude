_default:
  @just --choose

gen:
  @xcodegen -s project.yml

xcode:
  @open GertiePodcasts.xcodeproj

previews:
  @open previews/GertiePodcastsPreviews.xcodeproj

dev:
  pnpm concurrently --raw \
  -n lv,lc,lt,sp \
  -c cyan.dim,magenta.dim,green.dim,yellow.dim \
  "just --justfile {{justfile()}} watch-build lib-views" \
  "just --justfile {{justfile()}} watch-build lib-core" \
  "just --justfile {{justfile()}} watch-build lib-tca" \
  "just --justfile {{justfile()}} sync-previews"

build-views:
  @cd lib-views && swift build

format:
  @swiftformat .

# previews

gen-previews:
  @mkdir -p previews/sources
  @rsync -rc lib-views/Sources/ previews/sources
  @xcodegen -s previews.yml --project previews

sync-previews:
  just watch-swift lib-views/Sources '"rsync -rc lib-views/Sources/ previews/sources"'

# utility

[private]
watch-swift dir cmd ignore1="•" ignore2="•":
  @watchexec --project-origin . --clear --restart --watch {{dir}} --exts swift,html \
  --ignore '**/.build/*/**' --ignore '**/index.html' --ignore '{{ignore1}}' --ignore '{{ignore2}}' \
  {{cmd}}

watch-build dir:
  @just watch-swift {{dir}} '"cd {{dir}} && swift build"'

watch-test dir isolate="":
  @just watch-swift {{dir}} '"cd {{dir}} && \
  SWIFT_DETERMINISTIC_HASHING=1 swift test \
  {{ if isolate != "" { "--filter " + isolate } else { "" } }} "'
