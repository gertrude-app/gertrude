    "onboarding.explainAccount" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gertrude Podcasts is free to try for 30 days. After you try it, you’ll need a Gertrude account. Just $10/year for all your family’s devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gertrude Podcasts es gratis para probar durante 30 días. Después de probarlo, necesitarás una cuenta de Gertrude. Solo $10 al año para todos los dispositivos de tu familia."
          }
        }
      }
    },
