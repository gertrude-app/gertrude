{
  "sourceLanguage" : "en",
  "strings" : {
    "onboarding.areYouParent" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For the initial setup, we need the parent for a few minutes. Are you the parent?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para la configuración inicial, necesitamos al padre o madre por unos minutos. ¿Eres tú el padre/madre?"
          }
        }
      }
    },
    "onboarding.yesParent" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yes, I'm the parent"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sí, soy el padre/madre"
          }
        }
      }
    },
    "onboarding.noChild" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No, I'm the child"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No, soy el hijo/hija"
          }
        }
      }
    },
    "onboarding.parentRequired" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll need your parent to set this up, go get them and click continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitarás a tu padre o madre para configurar esto, ve a buscarlos y haz clic en continuar."
          }
        }
      }
    },
    "onboarding.continue" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuar"
          }
        }
      }
    },
    "onboarding.explainPin" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Next we need you to create a PIN that only you (the parent) know. Searching for and subscribing to new podcasts will require this PIN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora necesitamos que crees un PIN que solo tú (el padre/madre) conozcas. Buscar y suscribirse a nuevos podcasts requerirá este PIN."
          }
        }
      }
    },
    "onboarding.gotItNext" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Got it, next"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entendido, siguiente"
          }
        }
      }
    },
    "onboarding.strongPin" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure your PIN is not something you’ve used before, and never let your child watch you enter it. Write it down somewhere because there’s no way to recover it if you forget it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrate de que tu PIN no sea algo que hayas usado antes, y nunca permitas que tu hijo te vea ingresarlo. Anótalo en algún lugar porque no hay forma de recuperarlo si lo olvidas."
          }
        }
      }
    },
    "onboarding.strongPin.connected" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure your PIN is not something you’ve used before, and never let your child watch you enter it. If you forget it, you can reset it from your Gertrude account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrate de que tu PIN no sea algo que hayas usado antes, y nunca permitas que tu hijo te vea ingresarlo. Si lo olvidas, puedes restablecerlo desde tu cuenta de Gertrude."
          }
        }
      }
    },
    "onboarding.okLetsGo" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
