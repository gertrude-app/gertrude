import '../watch-helpers.just'

swiftly := "${SWIFTLY_HOME_DIR:-$HOME/.swiftly}/bin/swiftly"

_default:
  @just --choose

gen local_api_endpoint="":
  #!/usr/bin/env bash
  set -euo pipefail
  endpoint='{{local_api_endpoint}}'
  endpoint="${endpoint:-${LOCAL_API_ENDPOINT:-}}"
  endpoint="${endpoint:-$(../../scripts/local-api-endpoint)}"
  LOCAL_API_ENDPOINT="$endpoint" \
    GERTRUDE_MUSIC_DEBUG_DEVELOPMENT_TEAM="${GERTRUDE_MUSIC_DEBUG_DEVELOPMENT_TEAM:-WFN83LM943}" \
    GERTRUDE_MUSIC_DEBUG_BUNDLE_IDENTIFIER="${GERTRUDE_MUSIC_DEBUG_BUNDLE_IDENTIFIER:-com.netrivet.gertrude.music.dev}" \
    xcodegen -s project.yml
  ../../scripts/derive-debug-plist app/Info.plist app/Info.Debug.additions.plist app/Info.Debug.plist
  xml-lint --fix app/Info.plist app/Info.Debug.plist

xcode:
  @just gen
  @open GertrudeMusic.xcodeproj

build-views:
  @cd lib-views && {{swiftly}} run swift build

build-tca:
  @cd lib-tca && {{swiftly}} run swift build

build:
  @just build-views
  @just build-tca

build-app:
  @xcodebuild -project GertrudeMusic.xcodeproj -scheme 'Gertrude Music' -configuration Debug -destination 'generic/platform=iOS Simulator' build

test:
  @cd lib-views && SWIFT_DETERMINISTIC_HASHING=1 {{swiftly}} run swift test
  @cd lib-tca && SWIFT_DETERMINISTIC_HASHING=1 {{swiftly}} run swift test

lint:
  @swiftformat --exclude '**/.build' --lint .

check:
  @just build
  @just test
  @just lint

fix:
  @swiftformat --exclude '**/.build' .
  @xml-lint --fix app/Info.plist app/Info.Debug.plist
  @prettier --write '**/*.json' '!**/.build/**'

clean:
  @rm -rf lib-views/.build lib-tca/.build
  @find lib-views lib-tca -type f \( -name '*.o' -o -name '*.d' -o -name '*.swiftdeps' -o -name '*.swiftdeps~' \) -delete
