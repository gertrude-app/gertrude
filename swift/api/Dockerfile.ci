FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN export DEBIAN_FRONTEND=noninteractive && \
    apt-get -q update && \
    apt-get -q install -y \
    binutils \
    git \
    rsync \
    unzip \
    gnupg2 \
    libc6-dev \
    libcurl4-openssl-dev \
    libicu-dev \
    libedit2 \
    libgcc-13-dev \
    libpython3-dev \
    libsqlite3-0 \
    libstdc++-13-dev \
    libxml2-dev \
    libncurses-dev \
    libz3-dev \
    pkg-config \
    tzdata \
    zlib1g-dev \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -O https://download.swift.org/swiftly/linux/swiftly-$(uname -m).tar.gz && \
    tar zxf swiftly-$(uname -m).tar.gz && \
    ./swiftly init --quiet-shell-followup && \
    rm swiftly-$(uname -m).tar.gz

ENV SWIFTLY_HOME_DIR=/root/.local/share/swiftly
ENV PATH="${SWIFTLY_HOME_DIR}/bin:${PATH}"

# NB: change swift version here as needed for prod build deploy
RUN . "${SWIFTLY_HOME_DIR}/env.sh" && swiftly install 6.3.1
RUN . "${SWIFTLY_HOME_DIR}/env.sh" && swiftly use 6.3.1

RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g pnpm && \
    rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch 0.58.5 https://github.com/nicklockwood/SwiftFormat && \
    cd SwiftFormat && swift build -c release && \
    cp .build/release/swiftformat /usr/local/bin/ && \
    cd .. && rm -rf SwiftFormat/

# NB: prewarm the api's external dependencies into a fixed path (/prewarm) so CI runs
# reuse them instead of recompiling Vapor/NIO/swift-syntax/etc every build. CI jobs rsync
# the freshly-checked-out sources over /prewarm (preserving /prewarm/api/.build) and build
# there, so swift's absolute-path build records stay valid. Rebuilt automatically by the
# swift-docker-images workflow when swift/api/Package.resolved changes (build context: ./swift).
ENV PREWARM=/prewarm
COPY api ${PREWARM}/api
COPY duet ${PREWARM}/duet
COPY gertie ${PREWARM}/gertie
COPY pairql ${PREWARM}/pairql
COPY pairql-macapp ${PREWARM}/pairql-macapp
COPY pairql-iosapp ${PREWARM}/pairql-iosapp
COPY pairql-podcasts ${PREWARM}/pairql-podcasts
COPY ts-interop ${PREWARM}/ts-interop
COPY ts-codable-macro ${PREWARM}/ts-codable-macro
COPY x-aws ${PREWARM}/x-aws
COPY x-postmark ${PREWARM}/x-postmark
COPY x-slack ${PREWARM}/x-slack
COPY x-stripe ${PREWARM}/x-stripe
COPY x-expect ${PREWARM}/x-expect
COPY x-http ${PREWARM}/x-http
COPY x-kit ${PREWARM}/x-kit
RUN cd ${PREWARM}/api && \
    TC=$(grep -oE '"inUse" *: *"[^"]+"' /root/.local/share/swiftly/config.json | grep -oE '[0-9][0-9.]+') && \
    XCTEST_LIB=$(dirname "$(find /root/.local/share/swiftly/toolchains/$TC -name 'libXCTest.so' -print -quit 2>/dev/null)") && \
    swift build -Xswiftc -I"${XCTEST_LIB}" && \
    swift build -c release -Xswiftc -I"${XCTEST_LIB}"

WORKDIR /workspace

CMD ["bash"]
