{
  "root": "api",
  "projectType": "app",
  "implicitDependencies": [
    "duet",
    "gertie",
    "pairql",
    "pairql-macapp",
    "pairql-blocker",
    "pairql-ios-apps",
    "ts-interop"
  ],
  "targets": {
    "build": {
      "outputs": ["{projectRoot}/.build/debug/Run"],
      "command": "cd api && ${SWIFTLY_HOME_DIR:-$HOME/.swiftly}/bin/swiftly run swift build"
    },
    "test": {
      "command": "cd api && SWIFT_DETERMINISTIC_HASHING=1 ${SWIFTLY_HOME_DIR:-$HOME/.swiftly}/bin/swiftly run swift test"
    },
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": ["sources", "^sources"],
      "options": {
        "cwd": "api",
        "command": "./.build/debug/Run serve --port 8082"
      }
    }
  }
}
