{
  "namedInputs": {
    "sources": ["{projectRoot}/Sources/**/*.swift", "{projectRoot}/Package.swift"],
    "tests": [
      "{projectRoot}/Sources/**/*.swift",
      "{projectRoot}/Tests/**/*.swift",
      "{projectRoot}/Package.swift"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": ["sources", "^sources"]
    },
    "test": {
      "cache": true,
      "inputs": ["tests", "^sources"]
    }
  },
  "defaultBase": "master",
  "useInferencePlugins": false,
  "tui": {
    "enabled": false
  }
}
